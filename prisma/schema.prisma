datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cars         Car[]
}

model Car {
  id              String           @id @default(uuid())
  userId          String
  brand           String
  model           String
  yearManufacture Int
  yearModel       Int
  plate           String?
  color           String?
  fuelType        String
  engine          String?
  currentMileage  Float
  nickname        String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenances    Maintenance[]
  fuelRecords     FuelRecord[]
  vehicleWebInfo  VehicleWebInfo?
  upgradeItems    UpgradeItem[]
  schedules       MaintenanceSchedule[]
  trips           Trip[]
  washRecords     WashRecord[]
  insurancePolicy InsurancePolicy?
  insuranceClaims InsuranceClaim[]
  financings      Financing[]
}

model Maintenance {
  id               String            @id @default(uuid())
  carId            String
  date             DateTime
  mileage          Float
  type             String
  workshop         String?
  description      String
  laborCost        Float
  totalPartsCost   Float             @default(0)
  totalCost        Float             @default(0)
  discount         Float?            @default(0)
  paymentMethod    String?           @default("À vista")
  installmentCount Int?              @default(1)
  installmentValue Float?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  car              Car               @relation(fields: [carId], references: [id], onDelete: Cascade)
  parts            MaintenancePart[]
}

model MaintenancePart {
  id            String      @id @default(uuid())
  maintenanceId String
  name          String
  brand         String?
  quantity      Float
  unitPrice     Float
  totalPrice    Float
  notes         String?
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
}

model FuelRecord {
  id                    String   @id @default(uuid())
  carId                 String
  date                  DateTime
  mileage               Float
  fuelType              String
  pricePerLiter         Float
  liters                Float
  totalPrice            Float
  gasStation            String?
  city                  String?
  fullTank              Boolean  @default(false)
  consumptionKmPerLiter Float?
  paymentMethod         String?  @default("À vista")
  installmentCount      Int?     @default(1)
  installmentValue      Float?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  car                   Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model VehicleWebInfo {
  id                 String    @id @default(uuid())
  carId              String    @unique
  tankCapacity       Float?
  cityConsumption    Float?
  highwayConsumption Float?
  recommendedOil     String?
  tirePressure       String?
  tireSize           String?
  engineInfo         String?
  fuelType           String?
  generalNotes       String?
  sourceName         String?
  sourceUrl          String?
  searchedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  car                Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model MaintenanceSchedule {
  id              String    @id @default(uuid())
  carId           String
  type            String
  description     String?
  intervalKm      Float?
  intervalDays    Int?
  intervalMonths  Int?
  lastDoneMileage Float?
  lastDoneDate    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  car             Car       @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([carId, type])
}

model Trip {
  id              String    @id @default(uuid())
  carId           String
  title           String
  originCity      String
  destinationCity String
  startDate       DateTime
  endDate         DateTime?
  startMileage    Float?
  endMileage      Float?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  car             Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model UpgradeItem {
  id             String   @id @default(uuid())
  carId          String
  name           String
  description    String?
  estimatedValue Float?
  purchaseLink   String?
  status         String   @default("Pendente") // "Pendente" | "Concluido"
  priority       String   @default("Média") // "Baixa" | "Média" | "Alta"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  car            Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model WashRecord {
  id          String   @id @default(uuid())
  carId       String
  date        DateTime
  mileage     Float?
  selfWash    Boolean  @default(false)
  carWashName String?
  price       Float    @default(0)
  washType    String?  // "Completa" | "Externa" | "Interna" | "Motor" | "Detalhamento" | "Outro"
  notes       String?
  // JSON array de data URLs (máx. 3) ou 1 data URL legado; comprimidos no cliente
  photoData   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

// Apólice / dados do seguro do veículo (1 por carro)
model InsurancePolicy {
  id             String   @id @default(uuid())
  carId          String   @unique
  companyName    String
  policyNumber   String?
  coverageType   String?  // Completo, Terceiros, etc.
  monthlyValue   Float    @default(0)
  paymentDay     Int?     // dia do mês do pagamento (1-31)
  startDate      DateTime?
  endDate        DateTime?
  brokerName     String?
  notes          String?
  // JSON: [{ "label": "Sinistros 24h", "phone": "0800..." }]
  usefulContacts String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  car            Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  claims         InsuranceClaim[]
}

// Financiamentos e empréstimos do veículo (N por carro)
model Financing {
  id                   String    @id @default(uuid())
  carId                String
  kind                 String    @default("Financiamento") // Financiamento | Empréstimo
  institution          String    // banco / financeira / pessoa
  totalAmount          Float?    // valor financiado
  downPayment          Float?    // entrada
  installmentCount     Int       @default(0) // nº total de parcelas
  installmentValue     Float     @default(0) // valor da parcela
  monthlyDiscount      Float?    @default(0) // ajuda/desconto mensal de terceiro (abate da parcela)
  interestRate         Float?    // taxa de juros % a.m.
  paymentDay           Int?      // dia do mês do vencimento (1-31)
  firstInstallmentDate DateTime? // data da 1ª parcela
  lastPaidDate         DateTime? // vencimento já quitado (some o lembrete até o próximo)
  contractNumber       String?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  car                  Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
}

// Utilização do seguro (sinistro, guincho, etc.)
model InsuranceClaim {
  id          String          @id @default(uuid())
  policyId    String
  carId       String
  date        DateTime
  type        String          // Sinistro, Assistência 24h, Guincho, Vidro, Colisão, Outro
  description String
  amount      Float?
  deductible  Float?          // franquia
  status      String          @default("Aberto") // Aberto | Em análise | Concluído | Negado
  protocol    String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  policy      InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  car         Car             @relation(fields: [carId], references: [id], onDelete: Cascade)
}
